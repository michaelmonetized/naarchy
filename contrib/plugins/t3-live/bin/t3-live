#!/usr/bin/env python3
"""T3 Code live activities for Naarchy.

Polls the local T3 Code server's MCP endpoint (streamable HTTP at /mcp,
protocol 2025-06-18) and publishes one island activity per active agent
thread: project, status, elapsed time. Read-only: it only calls
t3_project_list, t3_thread_list and t3_thread_read with an
orchestration:read credential.

Environment (all optional):
  T3_URL               server origin; default from <T3 home>/userdata/server-runtime.json
  T3CODE_HOME          T3 home (default ~/.t3)
  T3_MCP_TOKEN         bearer token; otherwise one is minted once with
                       `t3 auth session issue --subject mcp-client --scope orchestration:read`
                       and kept in $NAARCHY_PLUGIN_DATA/mcp-token (0600)
  T3_LIVE_AUTO_TOKEN   set to 0 to never mint a token
  T3_BIN               path to the t3 CLI
  T3_LIVE_INTERVAL     poll seconds (default 4)
  T3_LIVE_ONCE         set to 1 to print one snapshot as JSON and exit (debugging)

Python 3.8+ standard library only.
"""

import json
import os
import shutil
import subprocess
import sys
import threading
import time
import urllib.error
import urllib.request
from datetime import datetime

PROTOCOL = "2025-06-18"
ACTIVE = ["preparing", "queued", "starting", "running", "waiting"]
ICON = "\uf544"  # nf-fa-robot
MAX_THREADS = 8  # the island host keeps at most 8 activities per plugin


def t3_home():
    return os.environ.get("T3CODE_HOME") or os.path.expanduser("~/.t3")


def server_origin():
    if os.environ.get("T3_URL"):
        return os.environ["T3_URL"].rstrip("/")
    try:
        with open(os.path.join(t3_home(), "userdata", "server-runtime.json")) as f:
            origin = json.load(f).get("origin")
        if origin:
            return origin.rstrip("/")
    except (OSError, ValueError):
        pass
    return "http://127.0.0.1:3773"


def data_dir():
    d = os.environ.get("NAARCHY_PLUGIN_DATA") or os.path.expanduser(
        "~/.local/share/naarchy/plugins/t3-live"
    )
    os.makedirs(d, mode=0o700, exist_ok=True)
    return d


def find_t3():
    for candidate in (
        os.environ.get("T3_BIN"),
        shutil.which("t3"),
        os.path.join(t3_home(), "bin", "t3"),
        os.path.expanduser("~/.local/bin/t3"),
    ):
        if candidate and os.access(candidate, os.X_OK):
            return candidate
    return None


class Credentials:
    def __init__(self):
        self.path = os.path.join(data_dir(), "mcp-token")
        self.last_mint = 0.0

    def get(self):
        if os.environ.get("T3_MCP_TOKEN"):
            return os.environ["T3_MCP_TOKEN"].strip()
        try:
            with open(self.path) as f:
                token = f.read().strip()
            if token:
                return token
        except OSError:
            pass
        return self.mint()

    def mint(self):
        """Issue a read-only MCP client session with the local t3 CLI."""
        if os.environ.get("T3_MCP_TOKEN") or os.environ.get("T3_LIVE_AUTO_TOKEN") == "0":
            return None
        if time.time() - self.last_mint < 600:
            return None  # never hammer the auth store
        self.last_mint = time.time()
        t3 = find_t3()
        if not t3:
            log("warn", "t3 CLI not found; set T3_MCP_TOKEN or T3_BIN")
            return None
        cmd = [t3, "auth", "session", "issue", "--scope", "orchestration:read",
               "--subject", "mcp-client", "--label", "Naarchy live activities",
               "--ttl", "30d", "--token-only"]
        if os.environ.get("T3CODE_HOME"):
            cmd += ["--base-dir", os.environ["T3CODE_HOME"]]
        try:
            out = subprocess.run(cmd, capture_output=True, text=True, timeout=60, check=True).stdout
        except (OSError, subprocess.SubprocessError) as e:
            log("warn", "could not issue a T3 MCP token: %s" % e)
            return None
        lines = [l.strip() for l in out.splitlines() if l.strip()]
        if not lines:
            return None
        token = lines[-1]
        fd = os.open(self.path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
        with os.fdopen(fd, "w") as f:
            f.write(token + "\n")
        log("info", "issued a read-only T3 MCP credential")
        return token

    def forget(self):
        try:
            os.remove(self.path)
        except OSError:
            pass


class Unauthorized(Exception):
    pass


class Mcp:
    """Minimal MCP streamable-HTTP client: initialize once, then tools/call."""

    def __init__(self, origin, token):
        self.url = origin + "/mcp"
        self.token = token
        self.session = None
        self.next_id = 1

    def _post(self, body):
        headers = {
            "authorization": "Bearer " + self.token,
            "content-type": "application/json",
            "accept": "application/json, text/event-stream",
            "mcp-protocol-version": PROTOCOL,
        }
        if self.session:
            headers["mcp-session-id"] = self.session
        req = urllib.request.Request(self.url, json.dumps(body).encode(), headers)
        try:
            resp = urllib.request.urlopen(req, timeout=15)
        except urllib.error.HTTPError as e:
            if e.code == 401:
                raise Unauthorized()
            if e.code in (400, 404) and self.session:
                self.session = None  # server restarted; start a new MCP session
            raise
        with resp:
            sid = resp.headers.get("mcp-session-id")
            if sid:
                self.session = sid
            raw = resp.read().decode("utf-8", "replace")
            if not raw.strip():
                return None
            if resp.headers.get("content-type", "").startswith("text/event-stream"):
                for line in raw.splitlines():
                    if line.startswith("data:"):
                        msg = json.loads(line[5:])
                        if "id" in msg:
                            return msg
                return None
            return json.loads(raw)

    def _rpc(self, method, params=None):
        self.next_id += 1
        msg = self._post({"jsonrpc": "2.0", "id": self.next_id, "method": method,
                          "params": params or {}})
        if msg is None or "error" in msg:
            raise RuntimeError("%s failed: %s" % (method, (msg or {}).get("error")))
        return msg["result"]

    def ensure(self):
        if self.session:
            return
        self._rpc("initialize", {"protocolVersion": PROTOCOL, "capabilities": {},
                                 "clientInfo": {"name": "naarchy-t3-live", "version": "0.1.0"}})
        self._post({"jsonrpc": "2.0", "method": "notifications/initialized"})

    def call(self, tool, arguments):
        self.ensure()
        result = self._rpc("tools/call", {"name": tool, "arguments": arguments})
        if result.get("isError"):
            text = "".join(c.get("text", "") for c in result.get("content", []))
            raise RuntimeError("%s: %s" % (tool, text[:300]))
        if "structuredContent" in result:
            return result["structuredContent"]
        return json.loads(result["content"][0]["text"])


def epoch(iso):
    if not iso:
        return None
    try:
        return int(datetime.fromisoformat(iso.replace("Z", "+00:00")).timestamp())
    except ValueError:
        return None


def snapshot(mcp, cache):
    """Active threads across every project: list of activity dicts."""
    projects, cursor = [], None
    while True:
        args = {"limit": 100}
        if cursor is not None:
            args["cursor"] = cursor
        page = mcp.call("t3_project_list", args)
        projects += page.get("projects", [])
        cursor = page.get("nextCursor")
        if cursor is None:
            break
    found = []
    for project in projects:
        if project.get("deletedAt"):
            continue
        listing = mcp.call("t3_thread_list", {"projectId": project["id"], "statuses": ACTIVE,
                                              "settled": False, "limit": MAX_THREADS})
        for thread in listing.get("threads", []):
            found.append((project, thread))
    found.sort(key=lambda pt: pt[1].get("updatedAt", ""), reverse=True)
    activities = []
    for project, thread in found[:MAX_THREADS]:
        key = (thread["threadId"], thread.get("latestRunId"), thread["status"], thread.get("updatedAt"))
        detail = cache.get(key)
        if detail is None:
            read = mcp.call("t3_thread_read", {"threadId": thread["threadId"], "limit": 1,
                                               "runLimit": 3, "maxCharsPerItem": 1})
            runs = read.get("recentRuns", [])
            active = read["thread"].get("activeRunId") or read["thread"].get("latestRunId")
            run = next((r for r in runs if r.get("runId") == active), runs[0] if runs else None)
            started = None
            if run:
                started = epoch(run.get("startedAt")) or epoch(run.get("requestedAt"))
            detail = {"started": started or epoch(thread.get("updatedAt")),
                      "pending": read["thread"].get("pendingRequestCount", 0),
                      "branch": read["thread"].get("branch")}
            cache[key] = detail
        status = thread["status"]
        pending = detail["pending"]
        if pending:
            word, priority = "needs you", 70
        elif status == "waiting":
            word, priority = "finishing", 30
        else:
            word, priority = status, 40
        title = (thread.get("title") or "").strip()
        activities.append({
            "type": "activity",
            "id": thread["threadId"],
            "icon": ICON,
            "title": project.get("title") or os.path.basename(project.get("workspaceRoot", "")) or "T3",
            "detail": word + (" · " + title if title else ""),
            "started_at": detail["started"],
            "priority": priority,
        })
    live = {k for k in cache if any(k[0] == a["id"] for a in activities)}
    for k in list(cache):
        if k not in live:
            del cache[k]
    return activities


def emit(obj):
    sys.stdout.write(json.dumps(obj, ensure_ascii=False) + "\n")
    sys.stdout.flush()


def log(level, message):
    if os.environ.get("NAARCHY_PLUGIN"):
        emit({"type": "log", "level": level, "message": message})
    else:
        print("t3-live %s: %s" % (level, message), file=sys.stderr)


def exit_on_stdin_eof():
    """Protocol rule: Naarchy closing stdin means it is gone."""
    def watch():
        try:
            while sys.stdin.readline():
                pass
        except Exception:
            pass
        os._exit(0)
    threading.Thread(target=watch, daemon=True).start()


def main():
    interval = max(1.0, float(os.environ.get("T3_LIVE_INTERVAL", "4")))
    once = os.environ.get("T3_LIVE_ONCE") == "1"
    if not once and os.environ.get("NAARCHY_PLUGIN"):
        exit_on_stdin_eof()
    creds = Credentials()
    mcp, cache, shown = None, {}, {}
    last_error = None
    while True:
        try:
            if mcp is None:
                token = creds.get()
                if not token:
                    raise RuntimeError("no T3 MCP credential")
                mcp = Mcp(server_origin(), token)
            activities = snapshot(mcp, cache)
            if once:
                print(json.dumps(activities, indent=2, ensure_ascii=False))
                return 0
            current = {a["id"]: a for a in activities}
            for aid in list(shown):
                if aid not in current:
                    emit({"type": "clear", "id": aid})
                    del shown[aid]
            for aid, a in current.items():
                if shown.get(aid) != a:
                    emit(a)
                    shown[aid] = a
            if last_error:
                log("info", "T3 Code reachable again")
            last_error = None
        except Unauthorized:
            # Expired or revoked: drop it and mint a fresh one (rate limited).
            if not os.environ.get("T3_MCP_TOKEN"):
                creds.forget()
            mcp = None
            last_error = last_error or "unauthorized"
            if once:
                print("t3-live: T3 rejected the MCP credential", file=sys.stderr)
                return 1
        except Exception as e:  # server down, restarting, network blip
            message = str(e) or e.__class__.__name__
            if message != last_error:
                log("warn", "T3 Code unavailable: %s" % message)
            last_error = message
            if mcp is not None:
                mcp.session = None
            if shown:
                emit({"type": "clear"})
                shown.clear()
            if once:
                print("t3-live: %s" % message, file=sys.stderr)
                return 1
        time.sleep(interval)


if __name__ == "__main__":
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        sys.exit(0)
